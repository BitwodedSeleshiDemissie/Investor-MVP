# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# JSON array of login users. Required in production (login blocked if unset).
# Use bcrypt passwordHash in production; plaintext password is allowed only when
# ALLOW_PLAINTEXT_AUTH_USERS=true.
# Format: [{"email":"admin@example.com","passwordHash":"$2a$12$...","role":"admin"},
#           {"email":"investor@example.com","passwordHash":"$2a$12$...","role":"investor","investorName":"Name In Excel"}]
AUTH_USERS=
AUTH_TRUST_HOST=false
ALLOW_DEV_AUTH_USERS=false
ALLOW_PLAINTEXT_AUTH_USERS=false

# Optional AI review for Directa monthly uploads.
OPENAI_API_KEY=
OPENAI_AUDIT_MODEL=gpt-4o-mini
ENABLE_EXTERNAL_AI_REVIEW=false

# Optional Directa security classification helper.
ANTHROPIC_API_KEY=
ENABLE_EXTERNAL_AI_CLASSIFIER=false

DATABASE_URL=
DATABASE_SSL=false
CEO_BASELINE_WORKBOOK=./bootstrap/Ariete_Capital_Investment_Tracker.xlsx
BASELINE_DIRECTA_CASH=87386.04
BOOTSTRAP_FORCE=false
LOG_LEVEL=info
LOG_DIR=
LOG_FILE_NAME=application.log
NEXT_PUBLIC_APP_URL=http://localhost:3000
