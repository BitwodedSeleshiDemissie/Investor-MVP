generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model admin_anagrafe_baselines {
  id          BigInt   @id @default(autoincrement())
  file_name   String
  content     Bytes
  uploaded_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([uploaded_at(sort: Desc), id(sort: Desc)], map: "idx_admin_anagrafe_uploaded")
}

model admin_anagrafe_json_store {
  store_key  String   @id
  payload    Json
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model admin_controls {
  id                BigInt   @id @default(autoincrement())
  portfolio_id      String
  investor_name     String
  as_of_date        DateTime @db.Date
  capital_committed Float
  currency          String   @default("EUR")
  notes             String   @default("")
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  @@index([as_of_date, created_at], map: "idx_admin_controls_asof")
}

model admin_manual_values {
  id               BigInt           @id @default(autoincrement())
  as_of_date       DateTime         @db.Date
  item_key         String
  value            Float
  currency         String           @default("EUR")
  valuation_source String           @default("Admin input")
  valuation_method String           @default("")
  notes            String           @default("")
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  asset_dictionary asset_dictionary @relation(fields: [item_key], references: [item_key], onDelete: NoAction, onUpdate: NoAction)

  @@index([item_key, as_of_date, created_at], map: "idx_admin_manual_values_key_asof")
}

model asset_dictionary {
  item_key            String                @id
  display_name        String
  item_type           String
  subcategory         String
  currency            String                @default("EUR")
  active              Boolean               @default(true)
  sort_order          Int                   @default(0)
  notes               String                @default("")
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  admin_manual_values admin_manual_values[]
}

model directa_csv_files {
  id          BigInt    @id @default(autoincrement())
  filename    String    @unique
  month_end   DateTime? @db.Date
  content     String
  uploaded_at DateTime  @default(now()) @db.Timestamptz(6)
}

model directa_pdf_files {
  id                   BigInt                 @id @default(autoincrement())
  filename             String
  file_hash            String                 @unique
  statement_date       DateTime?              @db.Date
  liquidity            Float
  listed_total         Float
  uploaded_by          String                 @default("admin")
  uploaded_at          DateTime               @default(now()) @db.Timestamptz(6)
  content              Bytes
  directa_pdf_positions directa_pdf_positions[]

  @@index([statement_date, uploaded_at], map: "idx_directa_pdf_files_statement_date")
}

model directa_pdf_positions {
  id               BigInt            @id @default(autoincrement())
  pdf_file_id      BigInt
  row_number       Int
  row_hash         String            @unique
  statement_date   DateTime?         @db.Date
  security_name    String
  isin             String
  quantity         Float
  price            Float
  market_value     Float
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  directa_pdf_files directa_pdf_files @relation(fields: [pdf_file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([statement_date], map: "idx_directa_pdf_positions_statement_date")
  @@index([isin], map: "idx_directa_pdf_positions_isin")
  @@index([security_name], map: "idx_directa_pdf_positions_security")
  @@index([pdf_file_id], map: "idx_directa_pdf_positions_file")
}

model security_master {
  isin           String   @id
  display_name   String
  source         String   @default("Directa PDF")
  first_seen_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
  latest_price   Float?
  latest_market_value Float?
  latest_statement_date DateTime? @db.Date

  @@index([display_name], map: "idx_security_master_display_name")
  @@index([latest_statement_date], map: "idx_security_master_statement_date")
}

model directa_upload_batches {
  id                    BigInt                  @id @default(autoincrement())
  filename              String
  canonical_filename    String
  file_hash             String                  @unique
  month_end             DateTime?               @db.Date
  uploaded_by           String                  @default("admin")
  uploaded_at           DateTime                @default(now()) @db.Timestamptz(6)
  status                String                  @default("imported")
  transaction_row_count Int                     @default(0)
  position_row_count    Int                     @default(0)
  has_lending_or_collateral_rows Boolean        @default(false)
  statement_cash        Float?
  raw_file_id           BigInt?
  directa_cash_balances directa_cash_balances[]
  directa_positions     directa_positions[]
  directa_transactions  directa_transactions[]

  @@index([month_end, uploaded_at], map: "idx_directa_upload_batches_month")
  @@index([canonical_filename], map: "idx_directa_upload_batches_canonical")
}

model directa_transactions {
  id                 BigInt                 @id @default(autoincrement())
  upload_batch_id    BigInt
  row_number         Int
  row_hash           String                 @unique
  source_file        String
  file_date          DateTime?              @db.Date
  trade_date         DateTime               @db.Date
  settlement_date    DateTime?              @db.Date
  security_name      String                 @default("")
  reference          String                 @default("")
  transaction_type   String
  tipo               String?
  price              Float?
  currency           String                 @default("EUR")
  quantity           Float?
  amount             Float?
  commission         Float?
  created_at         DateTime               @default(now()) @db.Timestamptz(6)
  directa_upload_batches directa_upload_batches @relation(fields: [upload_batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([trade_date], map: "idx_directa_transactions_trade_date")
  @@index([security_name], map: "idx_directa_transactions_security")
  @@index([upload_batch_id], map: "idx_directa_transactions_batch")
}

model directa_positions {
  id                    BigInt                  @id @default(autoincrement())
  upload_batch_id       BigInt
  row_number            Int
  row_hash              String                  @unique
  source_file           String
  file_date             DateTime?               @db.Date
  month_end             DateTime?               @db.Date
  security_name         String
  quantity              Float
  price                 Float
  market_value          Float
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  directa_upload_batches directa_upload_batches @relation(fields: [upload_batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([month_end], map: "idx_directa_positions_month")
  @@index([security_name], map: "idx_directa_positions_security")
  @@index([upload_batch_id], map: "idx_directa_positions_batch")
}

model directa_cash_balances {
  id                    BigInt                  @id @default(autoincrement())
  upload_batch_id       BigInt
  row_hash              String                  @unique
  source_file           String
  month_end             DateTime?               @db.Date
  statement_cash        Float
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  directa_upload_batches directa_upload_batches @relation(fields: [upload_batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([month_end], map: "idx_directa_cash_balances_month")
  @@index([upload_batch_id], map: "idx_directa_cash_balances_batch")
}

model investor_profiles {
  id                BigInt   @id @default(autoincrement())
  name              String   @unique
  investor_type     String   @default("Individual")
  capital_eur       Float
  units             Float
  subscription_date DateTime @db.Date
  nav_unit_at_sub   Float    @default(1.0)
  active            Boolean  @default(true)
  notes             String   @default("")
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)

  @@index([active, subscription_date], map: "idx_investor_profiles_active")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model non_listed_transactions {
  id               BigInt   @id @default(autoincrement())
  transaction_date DateTime @db.Date
  tipo             String
  investee         String
  currency         String   @default("EUR")
  amount           Float
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  @@index([transaction_date(sort: Desc), created_at(sort: Desc)], map: "idx_non_listed_transactions_date")
}

model portfolio_snapshot_artifacts {
  id                  BigInt               @id @default(autoincrement())
  snapshot_id         BigInt?
  artifact_type       String
  file_name           String
  mime_type           String
  content             Bytes
  metadata            Json                 @default("{}")
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  portfolio_snapshots portfolio_snapshots? @relation(fields: [snapshot_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([snapshot_id, created_at(sort: Desc)], map: "idx_portfolio_snapshot_artifacts_snapshot")
}

model portfolio_snapshots {
  id                           BigInt                         @id @default(autoincrement())
  as_of_date                   DateTime                       @db.Date
  source_file                  String                         @default("")
  payload                      Json
  created_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  publication_status           String                         @default("published")
  published_at                 DateTime?                      @db.Timestamptz(6)
  approved_by                  String?
  approval_note                String?
  audit_report                 Json                           @default("{}")
  deterministic_checks         Json                           @default("[]")
  ai_summary                   String                         @default("")
  supersedes_snapshot_id       BigInt?
  finance_note                 String?
  portfolio_snapshot_artifacts portfolio_snapshot_artifacts[]
  portfolio_snapshots          portfolio_snapshots?           @relation("portfolio_snapshotsToportfolio_snapshots", fields: [supersedes_snapshot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_portfolio_snapshots    portfolio_snapshots[]          @relation("portfolio_snapshotsToportfolio_snapshots")

  @@index([as_of_date(sort: Desc), created_at(sort: Desc)], map: "idx_portfolio_snapshots_asof")
  @@index([publication_status, as_of_date(sort: Desc), created_at(sort: Desc)], map: "idx_portfolio_snapshots_status_asof")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model private_loan_transactions {
  id               BigInt   @id @default(autoincrement())
  transaction_date DateTime @db.Date
  tipo             String
  counterparty     String
  currency         String   @default("EUR")
  amount           Float
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  @@index([transaction_date(sort: Desc), created_at(sort: Desc)], map: "idx_private_loan_transactions_date")
}

model security_tipo_cache {
  security_name String   @id
  tipo          String
  created_at    DateTime @default(now()) @db.Timestamptz(6)
}

model fund_settings {
  id          BigInt   @id @default(autoincrement())
  setting_key String   @unique
  label       String   @default("")
  value       String
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_by  String   @default("admin")
}
